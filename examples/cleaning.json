{
  "normalize_columns": true,
  "trim_strings": true,
  "drop_empty_rows": true,
  "deduplicate": true,
  "deduplicate_on": ["customer_id"],
  "keep": "first",
  "date_columns": ["signup_date"],
  "date_options": {
    "signup_date": {
      "dayfirst": true
    }
  },
  "numeric_columns": ["revenue"],
  "numeric_options": {
    "revenue": {
      "decimal_separator": ".",
      "thousands_separator": ","
    }
  },
  "required_columns": ["customer_id", "email_address"]
}
